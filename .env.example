# ============================================================================
# SentinelAI — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to source control.
# ============================================================================

# --- Demo mode vs Research mode ---
# false = demo-safe defaults (honeypot/live-capture hidden)
# true  = all features unlocked (for judges / research)
RESEARCH_MODE=false

# --- Groq LLM API (required for agent triage) ---
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen/qwen3.8-27b

# --- AbuseIPDB API (optional, for IP reputation enrichment) ---
# Get your key at: https://www.abuseipdb.com/api
ABUSEIPDB_API_KEY=your-abuseipdb-key-here

# --- MongoDB ---
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB_NAME=sentinelai

# --- JWT Authentication ---
# Generate a random secret:  python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=CHANGE-ME-generate-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# --- Suricata IDS (optional, for live capture) ---
# SURICATA_BIN=C:\Users\User\suricata\suricata.exe
# SURICATA_CONFIG=C:\Users\User\suricata\suricata.yaml
# SURICATA_LOG_DIR=C:\Users\User\suricata\log\sentinel
