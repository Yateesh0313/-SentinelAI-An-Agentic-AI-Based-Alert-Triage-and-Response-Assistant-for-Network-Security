# SentinelAI Test Rules
alert icmp any any -> any any (msg:"SentinelAI: ICMP Ping Detected"; itype:8; sid:1000001; rev:1;)
alert http any any -> any any (msg:"SentinelAI: Outbound HTTP Traffic"; http.method; content:"GET"; sid:1000002; rev:1;)
alert dns any any -> any any (msg:"SentinelAI: DNS Query Detected"; dns.query; content:"google.com"; nocase; sid:1000003; rev:1;)
